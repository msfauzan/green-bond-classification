# Cloudflare R2 Configuration
# Get these from your Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=green-bond-storage
# Optional: override the derived endpoint (useful for custom domains)
# R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# Firecrawl API
# Get your API key from https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Prospektus Collector Settings
POJK_18_DATE=2023-01-01
MAX_CONCURRENT_EMITEN=10
FIRECRAWL_TIMEOUT=30

# Security (Optional but recommended)
# API_KEY=secure-random-string
# CORS_ORIGINS=*
